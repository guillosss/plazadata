# Copia este archivo como ".env" para desarrollo local. NUNCA subas ".env" al repositorio (está en .gitignore).

# Base de datos. Sin esta variable se usa sipsa.db en la carpeta del proyecto.
# DATABASE_URL=postgresql://usuario:clave@host/nombre_bd

# Clave del resumen privado (/admin). Mínimo 16 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_KEY=

# "produccion" oculta la documentación interactiva (/docs).
ENTORNO=desarrollo

# Número de proxies de confianza delante de la app (0 en local). Ver README, sección Seguridad.
PROXY_HOPS=0

# Dominios permitidos, separados por comas (opcional). Ejemplo: plazadata-xxxx.onrender.com
# ALLOWED_HOSTS=

LOG_LEVEL=INFO
